{
  "name": "flap-me-orbs",
  "productName": "Flap me Orbs",
  "version": "1.0.0",
  "description": "Flap, grab orbs, and climb worlds.",
  "main": "main.js",
  "author": "Flap me Orbs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.flapmeorbs.game",
    "productName": "Flap me Orbs",
    "executableName": "Flap me Orbs",
    "artifactName": "${productName} ${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "game.html"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
